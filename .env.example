# Use slechev/openwebrxplus-softmbe:latest for the SoftMBE variant.
OWRX_IMAGE=slechev/openwebrxplus:latest
OWRX_HTTP_PORT=8073
TZ=Europe/Sofia

OPENWEBRX_ADMIN_USER=admin
# Set a password before starting. Single quotes preserve literal $ and # signs.
OPENWEBRX_ADMIN_PASSWORD=''

# Enable after configuring your sources: set their expected available count.
# 0 disables the SDR source count check. The HTTP check remains enabled.
HEALTHCHECK_SDR_DEVICES=0
